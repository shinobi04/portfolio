                </div>

                <div className="flex flex-col mb-3 sm:mb-4 mt-1.5 sm:mt-2">
                  <div className="flex justify-between items-center">
                    <h3 className="text-base sm:text-lg md:text-xl font-semibold text-white mb-1 group-hover:bg-gradient-to-r group-hover:from-purple-400 group-hover:to-pink-500 group-hover:text-transparent group-hover:bg-clip-text transition-all duration-300">
                      {edu.title}
                    </h3>
                    <button
