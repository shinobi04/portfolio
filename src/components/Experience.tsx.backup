                                clipRule="evenodd"
                              />
                            </svg>
                            <span>{desc}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div>
                      <h4 className="text-xs md:text-sm uppercase tracking-wider text-indigo-400 mb-2 md:mb-3 font-medium">
