        <h2 className="text-2xl sm:text-3xl md:text-5xl font-bold bg-gradient-to-r from-purple-400 via-pink-500 to-indigo-400 text-transparent bg-clip-text mb-4 sm:mb-6 tracking-tight px-2">
          Education Journey
        </h2>
        <div className="w-16 sm:w-20 h-1 bg-gradient-to-r from-purple-500 to-pink-500 mx-auto mb-4 sm:mb-6 rounded-full"></div>
        <p className="text-white/70 max-w-2xl mx-auto text-base sm:text-lg px-4">
          Climbing through my academic path at USICT, Delhi
        </p>
      </motion.div>

      {/* Timeline view for desktop, cards for mobile */}
      <div className="relative">
        {/* Start flag for mobile - moved to top */}
        <motion.div
