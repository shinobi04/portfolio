                className="w-full bg-gradient-to-br from-black/70 to-gray-900/50 backdrop-blur-lg border border-white/10 rounded-xl p-4 sm:p-6 shadow-lg relative overflow-hidden group hover:bg-black/60 hover:border-white/20"
                whileHover={{
                  y: -5,
                  boxShadow: "0 15px 30px -10px rgba(168, 85, 247, 0.15)",
                }}
              >
                {/* Animated gradient border on hover */}
                <motion.div
                  className="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none"
