                    animate={{ opacity: 1, height: "auto" }}
                    exit={{ opacity: 0, height: 0 }}
                    transition={{ duration: 0.3 }}
                  >
                    <div className="border-l-2 border-purple-500/30 pl-3 md:pl-4 mb-3 md:mb-4">
                      <h4 className="text-xs md:text-sm uppercase tracking-wider text-purple-400 mb-1.5 md:mb-2 font-medium">
                        Highlights
                      </h4>
                      <ul className="space-y-1.5 md:space-y-2">
                        {edu.description.map((desc, i) => (
                          <li
                            key={i}
                            className="text-white/70 text-xs md:text-sm flex items-start"
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              className="h-3.5 w-3.5 md:h-4 md:w-4 text-green-400 mr-1.5 md:mr-2 mt-0.5 flex-shrink-0"
                              viewBox="0 0 20 20"
                              fill="currentColor"
                            >
                              <path
                                fillRule="evenodd"
                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                clipRule="evenodd"
                              />
                            </svg>
                            <span>{desc}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div>
                      <h4 className="text-xs sm:text-sm uppercase tracking-wider text-indigo-400 mb-2 sm:mb-3 font-medium">
                        Skills Gained
                      </h4>
                      <div className="flex flex-wrap gap-1.5 sm:gap-2">
                        {edu.skills.map((skill, i) => (
                          <span
                            key={i}
                            className="px-1.5 min-[400px]:px-2 sm:px-3 py-0.5 sm:py-1 bg-white/5 text-white/80 text-[9px] min-[400px]:text-[10px] sm:text-xs rounded-full border border-white/10"
                          >
