                >
                  <div className="absolute inset-0 rounded-xl p-[1px]">
                    <div className="absolute inset-0 rounded-xl bg-gradient-to-r from-purple-500/20 to-pink-500/20"></div>
                  </div>
                </motion.div>

                {/* Level badge */}
                <div className="absolute -top-2.5 sm:-top-3 left-4 sm:left-6 px-2.5 sm:px-4 py-1 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full text-[10px] sm:text-xs font-medium text-white shadow-lg shadow-purple-500/20 flex items-center">
                  <span className="mr-1">Level</span>
                  <span className="bg-white/20 w-4 h-4 sm:w-5 sm:h-5 rounded-full flex items-center justify-center ml-1">
                    {educationPath.length - index}
