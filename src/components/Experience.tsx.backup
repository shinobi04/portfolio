                  <div className="absolute -top-2.5 md:-top-3 left-4 md:left-6 px-2.5 md:px-3 py-1 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full text-[10px] md:text-xs font-medium md:font-bold text-white">
                    Level {educationPath.length - index}
                  </div>

                  <div className="flex flex-col mb-3 md:mb-4 mt-1.5 md:mt-2">
                    <div className="flex justify-between items-center">
                      <h3 className="text-lg md:text-xl font-semibold text-white mb-1">
                        {edu.title}
                      </h3>
                    </div>

                    <div className="flex items-center text-xs md:text-sm text-white/60 mb-1.5 md:mb-2">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        className="h-3.5 w-3.5 md:h-4 md:w-4 mr-1 md:mr-1.5 text-indigo-400"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          strokeLinecap="round"
                          strokeLinejoin="round"
                          strokeWidth={2}
                          d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                        />
                      </svg>
                      {edu.institution}
                    </div>

                    <div className="flex items-center text-xs md:text-sm text-white/60 mb-2 md:mb-3">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        className="h-3.5 w-3.5 md:h-4 md:w-4 mr-1 md:mr-1.5 text-pink-400"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          strokeLinecap="round"
                          strokeLinejoin="round"
                          strokeWidth={2}
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        />
                      </svg>
                      {edu.duration}
                    </div>
                  </div>

                  <motion.div
