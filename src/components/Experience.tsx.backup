          whileInView={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.5 }}
          viewport={{ once: true }}
          className="flex justify-center items-center mb-10 sm:mb-12 md:hidden"
        >
          <div className="w-8 h-8 sm:w-10 sm:h-10 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full shadow-[0_0_15px_rgba(34,197,94,0.5)] flex items-center justify-center relative">
            <span className="absolute inset-0 rounded-full bg-green-500 animate-ping opacity-30"></span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              className="h-4 w-4 sm:h-5 sm:w-5 text-white"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fillRule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clipRule="evenodd"
              />
            </svg>
          </div>
          <span className="ml-2 sm:ml-3 text-green-400 font-medium text-sm sm:text-base bg-gradient-to-r from-green-400 to-emerald-500 text-transparent bg-clip-text">
            Academic Start
          </span>
        </motion.div>

        {/* Start flag - for desktop - moved to top */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.8, delay: 0.5 }}
          viewport={{ once: true }}
          className="hidden md:flex flex-col items-center mb-16 lg:mb-24"
        >
          <div className="w-10 h-10 lg:w-12 lg:h-12 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full shadow-[0_0_15px_rgba(34,197,94,0.5)] flex items-center justify-center relative">
            <span className="absolute inset-0 rounded-full bg-green-500 animate-ping opacity-30"></span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              className="h-5 w-5 lg:h-6 lg:w-6 text-white"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fillRule="evenodd"
