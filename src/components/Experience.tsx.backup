                clipRule="evenodd"
              />
            </svg>
          </div>
          <span className="mt-2 lg:mt-3 text-green-400 font-medium text-base lg:text-lg bg-gradient-to-r from-green-400 to-emerald-500 text-transparent bg-clip-text">
            Academic Start
          </span>
        </motion.div>

        {/* Central vertical line with animated glow effect */}
        <motion.div
